<?xml version="1.0" encoding="utf-8"?>
<!--
  카카오톡이 테마로 알아보는 표시 두 가지:
   1) com.kakao.talk.v2.theme 권한 요청
   2) com.kakao.talk.theme.action.MAIN 을 받는 화면
  화면을 누르면 '테마 적용하기' 그림 + 버튼이 뜨고, 버튼은 카카오톡 테마 설정으로 바로 감.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.kakao.talk.v2.theme" />
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/theme_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.kakao.talk.theme.action.MAIN" />
            </intent-filter>
        </activity>
    </application>
</manifest>
